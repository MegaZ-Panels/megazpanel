# Backend env (placed at /etc/megazpanel/backend.env, mode 0600)

NODE_ENV=production
PORT=8080
HOST=127.0.0.1

WEB_ORIGIN=https://panel.example.com

# DATABASE_URL points at PgBouncer, not Postgres directly.
DATABASE_URL=postgresql://megaz:CHANGE_ME_AT_INSTALL@127.0.0.1:6432/megazpanel?schema=public

SESSION_COOKIE_NAME=mzp_sid
CSRF_COOKIE_NAME=mzp_csrf
SESSION_LIFETIME_HOURS=24
SESSION_REMEMBER_ME_DAYS=30
COOKIE_DOMAIN=panel.example.com
COOKIE_SECURE=true

# 32 random bytes (hex). Generated by the installer.
APP_SECRET=CHANGE_ME_AT_INSTALL

# SMTP for verification + password reset emails (optional).
# When unset, mail is logged to journald instead of sent.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_FROM=MegaZPanel <no-reply@panel.example.com>
