# MegaZPanel — standalone host monitor environment
# Placed at /etc/megazpanel/monitor.env (mode 0600, owner root)

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=PLACE_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=PLACE_ADMIN_CHAT_ID_HERE

# ── What to check ────────────────────────────────────────────────────────────
PANEL_DOMAIN=panel.example.com
BACKEND_URL=http://127.0.0.1:8080
DB_HOST=127.0.0.1
DB_PORT=6432

# Comma-separated systemd units that must be active.
SYSTEMD_UNITS=megazpanel-backend,postgresql,pgbouncer,nginx

# Disk thresholds.
DISK_PATH=/
DISK_WARN_PERCENT=85

# Memory threshold.
MEM_WARN_PERCENT=85

# State file used to deduplicate alerts.
STATE_FILE=/var/lib/megazpanel/monitor-state.json
