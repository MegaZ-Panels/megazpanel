# MegaZPanel backend environment

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Origin allowed by CORS (the frontend URL)
WEB_ORIGIN=http://localhost:3000

# Postgres connection. Use PgBouncer in front of Postgres in production.
DATABASE_URL=postgresql://megaz:megaz@localhost:5432/megazpanel?schema=public

# Cookie / session
SESSION_COOKIE_NAME=mzp_sid
CSRF_COOKIE_NAME=mzp_csrf
SESSION_LIFETIME_HOURS=24
SESSION_REMEMBER_ME_DAYS=30
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Used to derive request signing/HMAC secrets for tokens (verify, reset).
APP_SECRET=replace-me-with-32-bytes-of-random
