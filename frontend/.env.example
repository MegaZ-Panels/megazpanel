# MegaZPanel frontend environment

# Public origin or path that exposes the auth/backend API.
# Use a path (e.g. "/api") for same-origin reverse proxy in production,
# or a full URL (e.g. "http://localhost:8080/api") for local dev.
NEXT_PUBLIC_API_BASE_URL=/api

# Public app URL, used in email links and absolute redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
